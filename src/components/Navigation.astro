---
const { currentPath = '/' } = Astro.props;
const navItems = [
  { href: '/', labelZh: '首页', labelEn: 'Home' },
  { href: '/about', labelZh: '关于', labelEn: 'About' },
  { href: '/cv', labelZh: '简历', labelEn: 'CV' },
  { href: '/blog', labelZh: '博客', labelEn: 'Blog' },
];
---

<div id="main-menu" class="nav-links">
  {navItems.map(({ href, labelZh, labelEn }) => {
    const isActive = currentPath === href;
    return (
      <a href={href} class:list={['nav-link', { active: isActive }]}>
        <span class="lang-zh">{labelZh}</span>
        <span class="lang-en">{labelEn}</span>
      </a>
    );
  })}
</div>

<style>
  .nav-link .lang-en {
    display: none;
  }
  .nav-link .lang-zh {
    display: inline;
  }
  html.lang-en .nav-link .lang-en {
    display: inline;
  }
  html.lang-en .nav-link .lang-zh {
    display: none;
  }

  .nav-link.active {
    color: var(--color-primary);
    font-weight: var(--font-weight-black);
    border-bottom-color: var(--color-primary);
  }
</style>