---
import { navItems, isNavItemActive } from '../config/nav';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
---

<div id="main-menu" class="nav-links">
  {navItems.map((item) => {
    const isActive = isNavItemActive(item, currentPath);
    return (
      <a href={item.href} class:list={['nav-link', { active: isActive }]} aria-current={isActive ? 'page' : undefined}>
        <span class="lang-zh">{item.labelZh}</span>
        <span class="lang-en">{item.labelEn}</span>
      </a>
    );
  })}
</div>

<style>
  .nav-link.active {
    color: var(--color-primary);
    font-weight: var(--font-weight-black);
    border-bottom-color: var(--color-primary);
  }
</style>
