<button id="langToggle" class="lang-toggle" type="button" data-aria-label-zh="切换语言" data-aria-label-en="Toggle language" aria-label="切换语言">
  <span class="lang-toggle-icon" aria-hidden="true">
    <svg width="24" height="24" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg" fill="currentColor" aria-hidden="true"><path d="M478.33,433.6l-90-218a22,22,0,0,0-40.67,0l-90,218a22,22,0,1,0,40.67,16.79L316.66,406H419.33l18.33,44.39A22,22,0,0,0,458,464a22,22,0,0,0,20.32-30.4ZM334.83,362,368,281.65,401.17,362Z"/><path d="M267.84,342.92a22,22,0,0,0-4.89-30.7c-.2-.15-15-11.13-36.49-34.73,39.65-53.68,62.11-114.75,71.27-143.49H330a22,22,0,0,0,0-44H214V70a22,22,0,0,0-44,0V90H54a22,22,0,0,0,0,44H251.25c-9.52,26.95-27.05,69.5-53.79,108.36-31.41-41.68-43.08-68.65-43.17-68.87a22,22,0,0,0-40.58,17c.58,1.38,14.55,34.23,52.86,83.93.92,1.19,1.83,2.35,2.74,3.51-39.24,44.35-77.74,71.86-93.85,80.74a22,22,0,1,0,21.07,38.63c2.16-1.18,48.6-26.89,101.63-85.59,22.52,24.08,38,35.44,38.93,36.1a22,22,0,0,0,30.75-4.9Z"/></svg>
  </span>
</button>

<script is:inline>
  (function initLang() {
    var stored = localStorage.getItem('lang');
    var lang = (stored === 'en' || stored === 'zh') ? stored : 'zh';
    document.documentElement.lang = lang;
    document.documentElement.classList.toggle('lang-en', lang === 'en');
    document.documentElement.classList.toggle('lang-zh', lang === 'zh');
  })();

  document.getElementById('langToggle')?.addEventListener('click', function () {
    var html = document.documentElement;
    var next = html.lang === 'zh' ? 'en' : 'zh';
    html.lang = next;
    html.classList.toggle('lang-en', next === 'en');
    html.classList.toggle('lang-zh', next === 'zh');
    localStorage.setItem('lang', next);
    var title = html.getAttribute(next === 'en' ? 'data-page-title-en' : 'data-page-title-zh');
    if (title) document.title = title + ' | Pengui.dev';
    document.querySelectorAll('a[data-title-zh]').forEach(function (a) {
      var t = a.getAttribute(next === 'en' ? 'data-title-en' : 'data-title-zh');
      if (t) a.setAttribute('title', t);
    });
    document.querySelectorAll('[data-aria-label-zh]').forEach(function (el) {
      var t = el.getAttribute(next === 'en' ? 'data-aria-label-en' : 'data-aria-label-zh');
      if (t) el.setAttribute('aria-label', t);
    });
  });
</script>

<style>
  .lang-toggle {
    border: 0;
    background: none;
    cursor: pointer;
    padding: var(--spacing-sm);
    color: var(--color-text);
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 2.25rem;
    min-height: 2.25rem;
  }

  .lang-toggle:hover {
    color: var(--color-primary);
  }

  .lang-toggle-icon {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lang-toggle-icon svg {
    display: block;
    width: 1.25rem;
    height: 1.25rem;
  }
</style>
