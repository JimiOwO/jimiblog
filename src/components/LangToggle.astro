<button id="langToggle" class="lang-toggle" type="button" data-aria-label-zh="切换语言" data-aria-label-en="Toggle language" aria-label="切换语言">
  <span class="lang-toggle-icon" aria-hidden="true">
    <svg width="24" height="24" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg" fill="currentColor" aria-hidden="true"><path d="M478.33,433.6l-90-218a22,22,0,0,0-40.67,0l-90,218a22,22,0,1,0,40.67,16.79L316.66,406H419.33l18.33,44.39A22,22,0,0,0,458,464a22,22,0,0,0,20.32-30.4ZM334.83,362,368,281.65,401.17,362Z"/><path d="M267.84,342.92a22,22,0,0,0-4.89-30.7c-.2-.15-15-11.13-36.49-34.73,39.65-53.68,62.11-114.75,71.27-143.49H330a22,22,0,0,0,0-44H214V70a22,22,0,0,0-44,0V90H54a22,22,0,0,0,0,44H251.25c-9.52,26.95-27.05,69.5-53.79,108.36-31.41-41.68-43.08-68.65-43.17-68.87a22,22,0,0,0-40.58,17c.58,1.38,14.55,34.23,52.86,83.93.92,1.19,1.83,2.35,2.74,3.51-39.24,44.35-77.74,71.86-93.85,80.74a22,22,0,1,0,21.07,38.63c2.16-1.18,48.6-26.89,101.63-85.59,22.52,24.08,38,35.44,38.93,36.1a22,22,0,0,0,30.75-4.9Z"/></svg>
  </span>
</button>

<script>
  // 初始语言已由 BaseLayout <head> 里的内联脚本确定（防闪烁），这里负责同步文案与处理切换
  type Lang = 'zh' | 'en';

  const root = document.documentElement;

  function applyLang(lang: Lang) {
    root.lang = lang;
    root.classList.toggle('lang-en', lang === 'en');
    root.classList.toggle('lang-zh', lang === 'zh');

    const title = root.getAttribute(`data-page-title-${lang}`);
    if (title) document.title = title;

    // 带 data-aria-label-zh/en、data-title-zh/en 的元素随语言更新对应属性
    document.querySelectorAll<HTMLElement>('[data-aria-label-zh]').forEach((el) => {
      const label = el.getAttribute(`data-aria-label-${lang}`);
      if (label) el.setAttribute('aria-label', label);
    });
    document.querySelectorAll<HTMLElement>('[data-title-zh]').forEach((el) => {
      const text = el.getAttribute(`data-title-${lang}`);
      if (text) el.setAttribute('title', text);
    });
  }

  applyLang(root.lang === 'en' ? 'en' : 'zh');

  document.getElementById('langToggle')?.addEventListener('click', () => {
    const next: Lang = root.lang === 'zh' ? 'en' : 'zh';
    try {
      localStorage.setItem('lang', next);
    } catch {}
    applyLang(next);
  });
</script>

<style>
  .lang-toggle {
    border: 0;
    background: none;
    cursor: pointer;
    padding: var(--spacing-sm);
    color: var(--color-text);
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 2.25rem;
    min-height: 2.25rem;
  }

  .lang-toggle:hover {
    color: var(--color-primary);
  }

  .lang-toggle-icon {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lang-toggle-icon svg {
    display: block;
    width: 1.25rem;
    height: 1.25rem;
  }
</style>
