---
const { platform, URL } = Astro.props;

const normalized = platform.toLowerCase();

// 从 src/icons/*.svg 自动加载，按文件名（小写）匹配 platform，之后新增平台只需放 SVG 文件即可
const iconModules = import.meta.glob<string>('../icons/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});

const iconMap: Record<string, string> = {};
for (const path in iconModules) {
  const name = path.replace(/^.*\/([^/]+)\.svg$/, '$1').toLowerCase();
  iconMap[name] = iconModules[path];
}

const rawSvg = iconMap[normalized];
const svgHtml = rawSvg
  ? rawSvg.replace(/<svg/, '<svg aria-hidden="true"').trim()
  : '';
---

<a href={URL} target="_blank" rel="noopener noreferrer" class="social-link">
  <span class="social-icon" set:html={svgHtml} />
  <span class="social-label">{platform}</span>
</a>

<style>
  .social-link {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    padding: 4px 8px;
    border-radius: 999px;
    border: var(--border-width-thin) solid var(--color-border-light);
    background-color: var(--color-bg);
    color: var(--color-text);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
    transition: background-color var(--transition-base),
                border-color var(--transition-base),
                transform var(--transition-fast),
                box-shadow var(--transition-base);
    will-change: transform;
    transform: translateZ(0);
  }

  .social-link:hover {
    border-color: var(--color-primary);
    background-color: var(--color-bg-secondary);
    transform: translateY(-1px) translateZ(0);
    box-shadow: var(--shadow-sm);
  }

  .social-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
  }

  .social-icon :global(svg) {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  .social-label {
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
</style>
