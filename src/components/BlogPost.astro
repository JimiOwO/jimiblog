---
const { url, title, tags = [], pubDate } = Astro.props;
const dateStr = pubDate ? new Date(pubDate).toISOString().slice(0, 10) : '';
---

<li class="blog-post-item">
  <a href={url} class="blog-post-link">{title}</a>
  <div class="blog-post-meta">
    {dateStr && <span class="blog-post-date">{dateStr}</span>}
    {tags && tags.length > 0 && (
      <div class="blog-post-tags">
        {tags.map((tag: string) => (
          <span class="tag tag-small">{tag}</span>
        ))}
      </div>
    )}
  </div>
</li>

<style>
  .blog-post-item {
    padding: var(--spacing-md);
    border-bottom: var(--border-width-thin) solid var(--color-border-light);
    transition: background-color var(--transition-base);
  }

  .blog-post-item:hover {
    background-color: var(--color-bg-secondary);
  }

  .blog-post-item:last-child {
    border-bottom: none;
  }

  .blog-post-link {
    font-size: clamp(1.25rem, 3vw, var(--font-size-2xl));
    font-weight: var(--font-weight-bold);
    color: var(--color-text);
    display: block;
    margin-bottom: var(--spacing-xs);
  }

  .blog-post-link:hover {
    color: var(--color-primary);
    border-bottom: var(--border-width-medium) solid var(--color-primary);
  }

  .blog-post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-sm);
    margin-top: var(--spacing-xs);
  }

  .blog-post-date {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
  }

  .blog-post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xs);
  }

  .tag-small {
    font-size: var(--font-size-xs);
    padding: 2px var(--spacing-xs);
    background-color: var(--color-bg-secondary);
    border: var(--border-width-thin) dotted var(--color-border);
  }
</style>
