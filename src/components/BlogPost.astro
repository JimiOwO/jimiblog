---
const { url, title, tags = [] } = Astro.props;
---

<li class="blog-post-item">
  <a href={url} class="blog-post-link">{title}</a>
  {tags && tags.length > 0 && (
    <div class="blog-post-tags">
      {tags.map((tag: string) => (
        <span class="tag tag-small">{tag}</span>
      ))}
    </div>
  )}
</li>

<style>
  .blog-post-item {
    padding: var(--spacing-md);
    border-bottom: var(--border-width-thin) solid var(--color-border-light);
    transition: background-color var(--transition-base);
  }

  .blog-post-item:hover {
    background-color: var(--color-bg-secondary);
  }

  .blog-post-item:last-child {
    border-bottom: none;
  }

  .blog-post-link {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    color: var(--color-text);
    display: block;
    margin-bottom: var(--spacing-xs);
  }

  .blog-post-link:hover {
    color: var(--color-primary);
    border-bottom: var(--border-width-medium) solid var(--color-primary);
  }

  .blog-post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xs);
    margin-top: var(--spacing-xs);
  }

  .tag-small {
    font-size: var(--font-size-xs);
    padding: 2px var(--spacing-xs);
    background-color: var(--color-bg-secondary);
    border: var(--border-width-thin) dotted var(--color-border);
  }
</style>
