---
import Menu from './Menu.astro';
import Navigation from './Navigation.astro';
import ThemeIcon from './ThemeIcon.astro';
import LangToggle from './LangToggle.astro';

const { currentPath = '/' } = Astro.props;
---

<header class="header-isolate">
  <nav class="header-nav">
    <div class="header-nav-left">
      <ThemeIcon />
      <LangToggle />
    </div>
    <a href="/" class="header-logo" aria-label="首页">
      <img src="/icons/Jimi_dark.png" alt="" class="logo-img logo-light" />
      <img src="/icons/Jimi_light.png" alt="" class="logo-img logo-dark" />
    </a>
    <div class="header-nav-right">
      <Menu />
      <Navigation currentPath={currentPath} />
    </div>
  </nav>
</header>

<style>
  .header-isolate {
    isolation: isolate;
  }

  .header-nav {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--spacing-lg) var(--spacing-xl);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--spacing-md);
    position: relative;
  }

  .header-nav-left,
  .header-nav-right {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
  }

  .header-logo {
    display: flex;
    align-items: center;
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }

  .header-logo .logo-img {
    height: 5rem;
    width: auto;
  }

  .header-logo .logo-dark {
    display: none;
  }

  html.dark .header-logo .logo-light {
    display: none;
  }

  html.dark .header-logo .logo-dark {
    display: block;
  }

  /* ── 手机端：固定红色顶部栏 ── */
  @media screen and (max-width: 635px) {
    .header-isolate {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: var(--z-fixed);
      background-color: var(--color-primary);
    }

    .header-nav {
      max-width: 100%;
      margin: 0;
      padding: 0 var(--spacing-md);
      height: 52px;
    }

    /* 红底上始终显示浅色 logo */
    .header-logo .logo-light {
      display: none !important;
    }
    .header-logo .logo-dark {
      display: block !important;
    }

    .header-logo .logo-img {
      height: 2.25rem;
    }

    /* 图标变白 */
    .header-nav-left :global(.theme-toggle),
    .header-nav-left :global(.lang-toggle) {
      color: var(--color-white);
    }

    .header-nav-left :global(.theme-toggle:hover),
    .header-nav-left :global(.lang-toggle:hover) {
      color: rgba(255, 255, 255, 0.7);
    }

    .header-nav-right :global(.menu) {
      color: var(--color-white);
    }

    .header-nav-right :global(.menu:hover) {
      color: rgba(255, 255, 255, 0.7);
    }
  }
</style>