---
import Menu from './Menu.astro';
import Navigation from './Navigation.astro';
import ThemeIcon from './ThemeIcon.astro';
import LangToggle from './LangToggle.astro';

const { currentPath = '/' } = Astro.props;
---

<header class="header-isolate">
  <nav class="header-nav">
    <div class="header-nav-left">
      <ThemeIcon />
      <LangToggle />
    </div>
    <a href="/" class="header-logo" aria-label="首页" data-aria-label-zh="首页" data-aria-label-en="Home">
      <img src="/icons/Jimi_dark.png" alt="" width="80" height="80" class="logo-img logo-light" />
      <img src="/icons/Jimi_light.png" alt="" width="80" height="80" class="logo-img logo-dark" />
    </a>
    <div class="header-nav-right">
      <Menu />
      <Navigation currentPath={currentPath} />
    </div>
  </nav>
</header>

<script>
  // 手机端：菜单按钮展开/收起导航面板；下滑隐藏顶栏，上滑一段距离后再显示
  const menu = document.querySelector<HTMLButtonElement>('.menu');
  const navLinks = document.querySelector<HTMLElement>('.nav-links');
  const header = document.querySelector<HTMLElement>('.header-isolate');
  const mobile = window.matchMedia('(max-width: 635px)');

  function isMenuOpen(): boolean {
    return menu?.getAttribute('aria-expanded') === 'true';
  }

  function setMenuOpen(open: boolean) {
    navLinks?.classList.toggle('is-open', open);
    menu?.setAttribute('aria-expanded', String(open));
  }

  menu?.addEventListener('click', () => setMenuOpen(!isMenuOpen()));

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && isMenuOpen()) {
      setMenuOpen(false);
      menu?.focus();
    }
  });

  // 在手机与桌面宽度之间切换时，重置面板状态
  mobile.addEventListener('change', () => setMenuOpen(false));

  if (header) {
    const SHOW_THRESHOLD = 52; // 顶栏高度；也是重新显示顶栏所需的最小上滑距离
    let lastScrollY = window.scrollY;
    let scrollUpAccum = 0;

    window.addEventListener(
      'scroll',
      () => {
        if (!mobile.matches) return;

        const currentScrollY = window.scrollY;

        if (currentScrollY > lastScrollY) {
          // 向下滑：重置上滑累计，隐藏顶栏并收起菜单
          scrollUpAccum = 0;
          if (currentScrollY > SHOW_THRESHOLD) {
            header.classList.add('header-hidden');
            setMenuOpen(false);
          }
        } else {
          // 向上滑：累计上滑距离，超过阈值才显示顶栏
          scrollUpAccum += lastScrollY - currentScrollY;
          if (scrollUpAccum >= SHOW_THRESHOLD) {
            header.classList.remove('header-hidden');
          }
        }

        lastScrollY = currentScrollY;
      },
      { passive: true }
    );
  }
</script>

<style>
  .header-isolate {
    isolation: isolate;
  }

  .header-nav {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--spacing-lg) var(--spacing-xl);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--spacing-md);
    position: relative;
  }

  .header-nav-left,
  .header-nav-right {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
  }

  .header-logo {
    display: flex;
    align-items: center;
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }

  .header-logo .logo-img {
    height: 5rem;
    width: auto;
  }

  .header-logo .logo-dark {
    display: none;
  }

  html.dark .header-logo .logo-light {
    display: none;
  }

  html.dark .header-logo .logo-dark {
    display: block;
  }

  /* ── 手机端：固定红色顶部栏 ── */
  @media screen and (max-width: 635px) {
    .header-isolate {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: var(--z-fixed);
      background-color: var(--color-primary);
      transition: transform 0.3s ease;
    }

    .header-isolate.header-hidden {
      transform: translateY(-100%);
    }

    .header-nav {
      max-width: 100%;
      margin: 0;
      padding: 0 var(--spacing-md);
      height: 52px;
    }

    /* 红底上始终显示浅色 logo */
    .header-logo .logo-light {
      display: none !important;
    }
    .header-logo .logo-dark {
      display: block !important;
    }

    .header-logo .logo-img {
      height: 2.25rem;
    }

    /* 图标变白 */
    .header-nav-left :global(.theme-toggle),
    .header-nav-left :global(.lang-toggle) {
      color: var(--color-white);
    }

    .header-nav-left :global(.theme-toggle:hover),
    .header-nav-left :global(.lang-toggle:hover) {
      color: rgba(255, 255, 255, 0.7);
    }

    .header-nav-right :global(.menu) {
      color: var(--color-white);
    }

    .header-nav-right :global(.menu:hover) {
      color: rgba(255, 255, 255, 0.7);
    }
  }
</style>