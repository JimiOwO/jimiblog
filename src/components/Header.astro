---
import Menu from './Menu.astro';
import Navigation from './Navigation.astro';
import ThemeIcon from './ThemeIcon.astro';
import LangToggle from './LangToggle.astro';

const { currentPath = '/' } = Astro.props;
---

<header class="header-isolate">
  <nav class="header-nav">
    <div class="header-nav-left">
      <ThemeIcon />
      <LangToggle />
      <Menu />
    </div>
    <a href="/" class="header-logo" aria-label="首页">
      <img src="/icons/Jimi_dark.png" alt="" class="logo-img logo-light" />
      <img src="/icons/Jimi_light.png" alt="" class="logo-img logo-dark" />
    </a>
    <Navigation currentPath={currentPath} />
  </nav>
</header>

<style>
  .header-isolate {
    isolation: isolate;
  }

  .header-nav {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--spacing-lg) var(--spacing-xl);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--spacing-md);
    position: relative;
  }

  .header-nav-left {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
  }

  .header-logo {
    display: flex;
    align-items: center;
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }

  .header-logo .logo-img {
    height: 5rem;
    width: auto;
  }

  .header-logo .logo-dark {
    display: none;
  }

  html.dark .header-logo .logo-light {
    display: none;
  }

  html.dark .header-logo .logo-dark {
    display: block;
  }

  @media screen and (max-width: 635px) {
    .header-nav {
      flex-direction: column;
      align-items: stretch;
    }

    .header-nav-left {
      justify-content: space-between;
    }

    .header-logo {
      position: static;
      transform: none;
      padding: var(--spacing-xl) 0;
      align-self: center;
    }
  }
</style>