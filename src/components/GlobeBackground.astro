---
import { visitedPlaces } from '../config/visitedPlaces';
---

<div class="globe-bg-wrap" aria-hidden="true">
  <canvas id="globe-bg-canvas"></canvas>
</div>

<script is:inline define:vars={{ placesData: visitedPlaces }}>
(async function () {
  var canvas = document.getElementById('globe-bg-canvas');
  if (!canvas) return;
  var ctx = canvas.getContext('2d');

  // 只用到地理投影，所以加载 d3-geo 子模块即可，不必下载整个 d3
  var d3, topojson;
  try {
    var results = await Promise.all([
      import('https://cdn.jsdelivr.net/npm/d3-geo@3/+esm'),
      import('https://cdn.jsdelivr.net/npm/topojson-client@3/+esm')
    ]);
    d3 = results[0];
    topojson = results[1];
  } catch (e) {
    console.warn('GlobeBackground: failed to load dependencies', e);
    return;
  }

  function getSize() {
    return Math.max(window.innerWidth, window.innerHeight) * 0.8;
  }

  var SIZE = getSize();
  canvas.width = SIZE;
  canvas.height = SIZE;

  var projection = d3.geoOrthographic()
    .scale(SIZE / 2 - 2)
    .translate([SIZE / 2, SIZE / 2])
    .clipAngle(90);

  var pathGen = d3.geoPath(projection, ctx);
  var graticule = d3.geoGraticule()();
  var sphere = { type: 'Sphere' };
  var rotation = [-110, -30, 0];
  var land = null;
  var borders = null;

  // Mouse-driven rotation + inertia + idle auto-rotate
  var ORIGIN_PHI    = -30;
  var RANGE_X       = 240;   // degrees sweepable left↔right
  var RANGE_Y       = 60;    // degrees sweepable up↔down
  var IDLE_SPEED    = 0.08;  // degrees per frame during idle
  var IDLE_TIMEOUT  = 300;   // ms of stillness before inertia kicks in
  var MOVE_THRESHOLD = 4;    // px of movement considered "significant"
  var INERTIA_DECAY  = 0.90; // velocity multiplier per frame
  var INERTIA_MIN    = 0.005; // stop inertia below this speed (degrees/frame)

  var activeLambdaBase = -110;
  var activePhibase    = ORIGIN_PHI;
  var targetLambda     = activeLambdaBase;
  var targetPhi        = ORIGIN_PHI;

  // state: 'idle' | 'active' | 'inertia'
  var state      = 'idle';
  var velLambda  = 0;
  var velPhi     = 0;
  var lastMoveX  = window.innerWidth  / 2;
  var lastMoveY  = window.innerHeight / 2;
  var lastMoveAt = 0;

  // 系统开启“减少动态效果”时，地球保持静止：不自转、不跟随鼠标
  var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduceMotion) window.addEventListener('mousemove', function (e) {
    var dx   = e.clientX - lastMoveX;
    var dy   = e.clientY - lastMoveY;
    var dist = Math.sqrt(dx * dx + dy * dy);
    if (dist < MOVE_THRESHOLD) return;

    lastMoveX  = e.clientX;
    lastMoveY  = e.clientY;
    lastMoveAt = Date.now();

    var relX = (e.clientX / window.innerWidth  - 0.5) * RANGE_X;
    var relY = (e.clientY / window.innerHeight - 0.5) * RANGE_Y;

    if (state !== 'active') {
      // Recalibrate bases so targetLambda == current rotation → no jump
      activeLambdaBase = rotation[0] - relX;
      activePhibase    = rotation[1] + relY;
      state = 'active';
    }

    var newLambda = activeLambdaBase + relX;
    var newPhi    = activePhibase    - relY;

    // Track velocity with light smoothing
    velLambda = velLambda * 0.4 + (newLambda - targetLambda) * 0.6;
    velPhi    = velPhi    * 0.4 + (newPhi    - targetPhi)    * 0.6;

    targetLambda = newLambda;
    targetPhi    = newPhi;
  });

  // 主题相关的取值只在主题切换时读取一次，不在每一帧里重复查询
  var dark = false;
  var dotColor = '';

  function readTheme() {
    dark = document.documentElement.classList.contains('dark');
    var style = getComputedStyle(document.documentElement);
    dotColor = style.getPropertyValue(dark ? '--color-primary-light' : '--color-primary').trim();
  }

  readTheme();

  function render() {
    ctx.clearRect(0, 0, SIZE, SIZE);
    projection.rotate(rotation);

    // Ocean
    ctx.beginPath();
    pathGen(sphere);
    ctx.fillStyle = dark ? '#1e1e1e' : '#ebebeb';
    ctx.fill();

    // Graticule
    ctx.beginPath();
    pathGen(graticule);
    ctx.strokeStyle = dark ? '#272727' : '#dedede';
    ctx.lineWidth = 0.5;
    ctx.stroke();

    // Land
    if (land) {
      ctx.beginPath();
      pathGen(land);
      ctx.fillStyle = dark ? '#363636' : '#c4c4c4';
      ctx.fill();
    }

    // Borders
    if (borders) {
      ctx.beginPath();
      pathGen(borders);
      ctx.strokeStyle = dark ? '#424242' : '#b4b4b4';
      ctx.lineWidth = 0.6;
      ctx.stroke();
    }

    // Globe outline
    ctx.beginPath();
    pathGen(sphere);
    ctx.strokeStyle = dark ? '#484848' : '#a8a8a8';
    ctx.lineWidth = 1.5;
    ctx.stroke();

    // Visited place dots
    ctx.fillStyle = dotColor;
    placesData.forEach(function (place) {
      var projected = projection(place.coords);
      if (!projected) return;

      ctx.beginPath();
      ctx.arc(projected[0], projected[1], 5, 0, Math.PI * 2);
      ctx.fill();
    });
  }

  function animate() {
    if (state === 'active' && Date.now() - lastMoveAt > IDLE_TIMEOUT) {
      state = 'inertia';
    }

    if (state === 'inertia') {
      targetLambda += velLambda;
      targetPhi    += velPhi;
      velLambda    *= INERTIA_DECAY;
      velPhi       *= INERTIA_DECAY;
      if (Math.abs(velLambda) < INERTIA_MIN && Math.abs(velPhi) < INERTIA_MIN) {
        velLambda = 0;
        velPhi    = 0;
        state     = 'idle';
      }
    }

    if (state === 'idle') {
      targetLambda += IDLE_SPEED;
      targetPhi    += (ORIGIN_PHI - targetPhi) * 0.02; // gently return to default tilt
    }

    rotation[0] += (targetLambda - rotation[0]) * 0.04;
    rotation[1] += (targetPhi    - rotation[1]) * 0.04;
    render();
    requestAnimationFrame(animate);
  }

  fetch('https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json')
    .then(function (r) {
      if (!r.ok) throw new Error('HTTP ' + r.status);
      return r.json();
    })
    .then(function (world) {
      land = topojson.feature(world, world.objects.land);
      borders = topojson.mesh(world, world.objects.countries, function (a, b) { return a !== b; });
      render();
    })
    .catch(function (e) { console.warn('GlobeBackground: failed to load world atlas', e); });

  // 静止模式只画一帧，之后仅在数据加载、主题切换、窗口缩放时重画
  if (reduceMotion) render();
  else animate();

  // 主题切换（html 的 class 变化）时更新颜色并重画
  new MutationObserver(function () {
    readTheme();
    render();
  }).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

  window.addEventListener('resize', function () {
    var newSize = getSize();
    if (Math.abs(newSize - SIZE) > 10) {
      SIZE = newSize;
      canvas.width = SIZE;
      canvas.height = SIZE;
      projection.scale(SIZE / 2 - 2).translate([SIZE / 2, SIZE / 2]);
      render();
    }
  });
})();
</script>

<style>
  .globe-bg-wrap {
    position: fixed;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    z-index: 0;
  }

  #globe-bg-canvas {
    border-radius: 50%;
    opacity: 0.28;
    display: block;
  }

  html.dark #globe-bg-canvas {
    opacity: 0.18;
  }
</style>
