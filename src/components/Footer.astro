---
import Social from './Social.astro';

const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-social">
    <Social platform="bilibili" URL="https://space.bilibili.com/4907375?spm_id_from=333.1007.0.0" />
    <Social platform="github" URL="https://github.com/JimiOwO" />
    <Social platform="instagram" URL="https://www.instagram.com/jimiowo/" />
    <Social platform="linkedin" URL="https://www.linkedin.com/in/jimipeng/" />
    <Social platform="duolingo" URL="https://www.duolingo.com/profile/000251.be8UMIZ2" />
  </div>
  
  <div class="footer-credits">
    <div class="footer-credits-content">
      <p class="footer-copyright">
        © 2025–{currentYear} <a href="https://github.com/JimiOwO" target="_blank" rel="noopener noreferrer">Jianye "Jimi" Peng</a>
        <span class="footer-separator">•</span>
        <a href="https://github.com/JimiOwO/jimiblog" target="_blank" rel="noopener noreferrer">
          <span class="lang-zh">查看源码</span>
          <span class="lang-en">View Source</span>
        </a>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    margin-top: var(--spacing-xl);
    padding-top: var(--spacing-xl);
    border-top: var(--border-width-thin) solid var(--color-border-light);
  }

  .footer-social {
    display: flex;
    gap: var(--spacing-sm);
    margin-left: 25%; /* 约在页面左侧1/4处 */
    align-items: center;
    flex-wrap: wrap;
  }

  .footer-credits {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: var(--spacing-md);
  }

  .footer-credits-content {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
    opacity: 0.5;
    letter-spacing: 0.02em;
  }

  .footer-copyright {
    margin: 0;
    line-height: 1.6;
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
  }

  .footer-separator {
    opacity: 0.4;
    margin: 0 var(--spacing-xs);
  }

  .footer-copyright a {
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: opacity var(--transition-base);
  }

  .footer-copyright a:hover {
    opacity: 0.8;
    text-decoration: underline;
    text-decoration-color: var(--color-text-secondary);
    text-underline-offset: 2px;
  }

  @media screen and (max-width: 768px) {
    .footer-social {
      margin-left: 0;
      justify-content: center;
    }
  }
</style>