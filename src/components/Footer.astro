---
import Social from './Social.astro';

const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-social">
    <Social platform="bilibili" URL="https://space.bilibili.com/4907375?spm_id_from=333.1007.0.0" />
    <Social platform="github" URL="https://github.com/JimiOwO" />
    <Social platform="instagram" URL="https://www.instagram.com/jimiowo/" />
    <Social platform="linkedin" URL="https://www.linkedin.com/in/jimipeng/" />
    <Social platform="duolingo" URL="https://www.duolingo.com/profile/000251.be8UMIZ2" />
  </div>

  <div class="footer-credits">
    <p class="footer-byline">
      © 2025{currentYear > 2025 ? `–${currentYear}` : ''}&nbsp;&nbsp;Jianye &ldquo;Jimi&rdquo; Peng&nbsp;&nbsp;·&nbsp;&nbsp;Views expressed are my own.
    </p>
  </div>
</footer>

<style>
  .footer {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
    margin-top: var(--spacing-xl);
    padding-top: var(--spacing-xl);
    border-top: var(--border-width-thin) solid var(--color-border-light);
  }

  .footer-social {
    display: flex;
    gap: var(--spacing-sm);
    margin-left: 25%;
    align-items: center;
    flex-wrap: wrap;
  }

  .footer-credits {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    padding-bottom: var(--spacing-md);
  }

  .footer-byline {
    margin: 0;
    font-size: var(--font-size-xs);
    letter-spacing: 0.04em;
    color: var(--color-text-secondary);
    opacity: 0.3;
  }

  @media screen and (max-width: 768px) {
    .footer-social {
      margin-left: 0;
      justify-content: center;
    }
  }
</style>