---
import BaseLayout from '../layouts/BaseLayout.astro';
const pageTitle = "简历";

const pdfUrl = '/CV.pdf';
---

<BaseLayout pageTitle={pageTitle} pageTitleZh="简历" pageTitleEn="CV">
  <div class="cv-container">
    <header class="cv-hero">
      <h1 class="cv-hero-bio bilingual-title">
        <span class="lang-zh">我能做什么/正在做什么/将要做什么</span>
        <span class="lang-en">What I have done<br>am doing<br>will do.</span>
      </h1>
    </header>
    <a href={pdfUrl} target="_blank" rel="noopener noreferrer" class="cv-preview-link" title="在新标签页打开 PDF">
      <div class="cv-preview" id="pdf-container" data-pdf-url={pdfUrl}>
        <div class="cv-loading"><span class="lang-zh">正在加载简历…</span><span class="lang-en">Loading CV…</span></div>
      </div>
    </a>
  </div>
</BaseLayout>

<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
<script>
  declare const pdfjsLib: any;

  async function renderPDF() {
    const container = document.getElementById('pdf-container');
    if (!container) return;

    if (typeof pdfjsLib === 'undefined') {
      setTimeout(renderPDF, 100);
      return;
    }

    pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';

    const pdfUrl = container.dataset.pdfUrl || '/CV.pdf';

    try {
      const loadingTask = pdfjsLib.getDocument(pdfUrl);
      const pdf = await loadingTask.promise;

      container.innerHTML = '';

      const MAX_PIXEL_RATIO = 3;
      const pixelRatio = Math.min(window.devicePixelRatio || 1, MAX_PIXEL_RATIO);
      const firstPage = await pdf.getPage(1);
      const baseViewport = firstPage.getViewport({ scale: 1 });
      const containerWidth = container.clientWidth || document.documentElement.clientWidth || 375;
      const scaleToFit = containerWidth / baseViewport.width;
      const scale = scaleToFit * pixelRatio;

      for (let pageNum = 1; pageNum <= pdf.numPages; pageNum++) {
        const page = await pdf.getPage(pageNum);
        const viewport = page.getViewport({ scale });

        const canvas = document.createElement('canvas');
        const context = canvas.getContext('2d');
        canvas.height = viewport.height;
        canvas.width = viewport.width;
        canvas.className = 'cv-page';
        canvas.style.width = containerWidth + 'px';
        canvas.style.height = (containerWidth * viewport.height / viewport.width) + 'px';

        await page.render({
          canvasContext: context,
          viewport: viewport
        }).promise;
        container.appendChild(canvas);
      }
    } catch (error) {
      console.error('PDF 加载失败:', error);
      const openPdf = pdfUrl;
      container.innerHTML = '<div class="cv-error"><span class="lang-zh">无法加载预览，<a href="' + openPdf + '" target="_blank" rel="noopener noreferrer">点击此处打开 PDF</a></span><span class="lang-en">Preview failed. <a href="' + openPdf + '" target="_blank" rel="noopener noreferrer">Click here to open PDF</a></span></div>';
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', renderPDF);
  } else {
    renderPDF();
  }
</script>

<style>
  .cv-hero {
    margin-bottom: 0;
  }

  .cv-hero-bio {
    margin: 0;
    font-size: clamp(1.9rem, 4.5vw, var(--font-size-page-title));
    font-weight: var(--font-weight-black);
    line-height: var(--line-height-tight);
    letter-spacing: var(--letter-spacing-tight);
    color: var(--color-text);
  }

  .cv-container {
    margin: 0 auto;
    max-width: 100%;
    overflow-x: hidden;
  }

  .cv-preview-link {
    display: block;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    max-width: 100%;
  }

  .cv-preview {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-md);
    padding: var(--spacing-lg);
    background: var(--color-bg);
    border-radius: var(--border-radius-sm);
    overflow-x: hidden;
  }

  .cv-page {
    display: block;
    max-width: 100%;
    width: 100%;
    height: auto;
    box-shadow: var(--shadow-md);
    margin-bottom: var(--spacing-md);
    background: var(--color-white);
    pointer-events: none;
    box-sizing: border-box;
  }

  .cv-loading,
  .cv-error {
    padding: var(--spacing-xl);
    text-align: center;
    color: var(--color-text-secondary);
  }

  .cv-error span {
    color: var(--color-link);
    font-weight: var(--font-weight-bold);
    text-decoration: underline;
  }

  @media screen and (max-width: 900px) {
    .cv-preview {
      padding: var(--spacing-md);
    }
  }
</style>
