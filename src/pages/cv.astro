---
import BaseLayout from '../layouts/BaseLayout.astro';

const pdfUrl = '/CV.pdf';
---

<BaseLayout pageTitle="简历" pageTitleZh="简历" pageTitleEn="CV">
  <div class="cv-container">
    <header class="cv-hero">
      <h1 class="cv-hero-bio bilingual-title">
        <span class="lang-zh">我能做什么/正在做什么/将要做什么</span>
        <span class="lang-en">What I have done<br>am doing<br>will do.</span>
      </h1>
    </header>
    <!-- 整块预览就是一个指向 PDF 的链接；预览加载失败时仍可点击打开 -->
    <a
      href={pdfUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="cv-preview-link"
      title="在新标签页打开 PDF"
      data-title-zh="在新标签页打开 PDF"
      data-title-en="Open the PDF in a new tab"
    >
      <div class="cv-preview" id="pdf-container" data-pdf-url={pdfUrl}>
        <div class="cv-loading"><span class="lang-zh">正在加载简历…</span><span class="lang-en">Loading CV…</span></div>
      </div>
    </a>
  </div>
</BaseLayout>

<script>
  // 用 pdf.js 把 PDF 的每一页画到 canvas 上作为预览；pdf.js 从 CDN 按需加载
  const PDFJS_BASE = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174';
  const MAX_PIXEL_RATIO = 3;

  declare const pdfjsLib: any;

  function loadScript(src: string): Promise<void> {
    return new Promise((resolve, reject) => {
      const script = document.createElement('script');
      script.src = src;
      script.onload = () => resolve();
      script.onerror = () => reject(new Error(`Failed to load ${src}`));
      document.head.appendChild(script);
    });
  }

  async function renderPDF(container: HTMLElement) {
    const pdfUrl = container.dataset.pdfUrl || '/CV.pdf';

    try {
      await loadScript(`${PDFJS_BASE}/pdf.min.js`);
      pdfjsLib.GlobalWorkerOptions.workerSrc = `${PDFJS_BASE}/pdf.worker.min.js`;

      const pdf = await pdfjsLib.getDocument(pdfUrl).promise;

      // 按容器内容区宽度（不含内边距）和屏幕像素比决定渲染分辨率；显示尺寸交给 CSS
      const style = getComputedStyle(container);
      const contentWidth =
        container.clientWidth - parseFloat(style.paddingLeft) - parseFloat(style.paddingRight) || 375;
      const pixelRatio = Math.min(window.devicePixelRatio || 1, MAX_PIXEL_RATIO);

      const pages: HTMLCanvasElement[] = [];
      for (let pageNum = 1; pageNum <= pdf.numPages; pageNum++) {
        const page = await pdf.getPage(pageNum);
        const baseViewport = page.getViewport({ scale: 1 });
        const viewport = page.getViewport({ scale: (contentWidth / baseViewport.width) * pixelRatio });

        const canvas = document.createElement('canvas');
        canvas.className = 'cv-page';
        canvas.width = Math.floor(viewport.width);
        canvas.height = Math.floor(viewport.height);

        await page.render({ canvasContext: canvas.getContext('2d'), viewport }).promise;
        pages.push(canvas);
      }

      container.replaceChildren(...pages);
    } catch (error) {
      console.error('PDF 加载失败:', error);
      container.innerHTML =
        '<div class="cv-error">' +
        '<span class="lang-zh">无法加载预览，点击此处打开 PDF</span>' +
        '<span class="lang-en">Preview failed. Click here to open the PDF.</span>' +
        '</div>';
    }
  }

  const container = document.getElementById('pdf-container');
  if (container) renderPDF(container);
</script>

<style>
  .cv-hero {
    margin-bottom: 0;
  }

  .cv-hero-bio {
    margin: 0;
    font-size: clamp(1.9rem, 4.5vw, var(--font-size-page-title));
    font-weight: var(--font-weight-black);
    line-height: var(--line-height-tight);
    letter-spacing: var(--letter-spacing-tight);
    color: var(--color-text);
  }

  .cv-container {
    margin: 0 auto;
    max-width: 100%;
    overflow-x: hidden;
  }

  .cv-preview-link {
    display: block;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    max-width: 100%;
  }

  .cv-preview {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-md);
    padding: var(--spacing-lg);
    background: var(--color-bg);
    border-radius: var(--border-radius-sm);
    overflow-x: hidden;
  }

  /* .cv-page 与 .cv-error 由脚本动态创建，不带 Astro 的作用域标记，所以要用 :global() 才能选中 */
  .cv-preview :global(.cv-page) {
    display: block;
    width: 100%;
    height: auto;
    box-shadow: var(--shadow-md);
    background: var(--color-white);
    pointer-events: none;
  }

  .cv-loading,
  .cv-preview :global(.cv-error) {
    padding: var(--spacing-xl);
    text-align: center;
    color: var(--color-text-secondary);
  }

  .cv-preview :global(.cv-error span) {
    color: var(--color-link);
    font-weight: var(--font-weight-bold);
    text-decoration: underline;
  }

  @media screen and (max-width: 900px) {
    .cv-preview {
      padding: var(--spacing-md);
    }
  }
</style>
