---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { type PostEntry } from '../../utils/posts';

const allPosts = Object.values(import.meta.glob<PostEntry>('../posts/*.md', { eager: true })) as PostEntry[];
const tags = [...new Set(allPosts.map((post) => post.frontmatter.tags).flat())].sort();
const pageTitle = "标签索引";
---

<BaseLayout pageTitle={pageTitle} pageTitleZh="标签索引" pageTitleEn="Tags">
  <div class="tags-container">
    {tags.map((tag) => (
      <span class="tag">
        <a href={`/tags/${tag}`}>{tag}</a>
      </span>
    ))}
  </div>
</BaseLayout>