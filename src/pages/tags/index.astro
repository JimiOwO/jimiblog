---
import BaseLayout from '../../layouts/BaseLayout.astro';
type PostWithTags = { frontmatter: { tags: string[] } };
const allPosts = Object.values(import.meta.glob<PostWithTags>('../posts/*.md', { eager: true })) as PostWithTags[];
const tags = [...new Set(allPosts.map((post) => post.frontmatter.tags).flat())];
const pageTitle = "标签索引";
---

<BaseLayout pageTitle={pageTitle} pageTitleZh="标签索引" pageTitleEn="Tags">
  <div class="tags-container">
    {tags.map((tag) => (
      <span class="tag">
        <a href={`/tags/${tag}`}>{tag}</a>
      </span>
    ))}
  </div>
</BaseLayout>