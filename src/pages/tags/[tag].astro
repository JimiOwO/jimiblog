---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogPost from '../../components/BlogPost.astro';
import { type PostEntry, sortPostsByDate } from '../../utils/posts';

export function getStaticPaths() {
  const globModules = import.meta.glob<PostEntry>('../posts/*.md', { eager: true });
  const allPosts: PostEntry[] = Object.values(globModules) as PostEntry[];
  const uniqueTags: string[] = [...new Set(allPosts.map((p) => p.frontmatter.tags).flat())];

  return uniqueTags.map((tag: string) => {
    const filteredPosts = allPosts.filter((p) => p.frontmatter.tags.includes(tag));
    return { params: { tag }, props: { posts: sortPostsByDate(filteredPosts) } };
  });
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<BaseLayout pageTitle={tag} pageTitleZh={tag} pageTitleEn={tag}>
  <p><span class="lang-zh">包含「<strong>{tag}</strong>」标签的文章</span><span class="lang-en">Posts with tag «<strong>{tag}</strong>»</span></p>
  <ul style="list-style: none; padding: 0;">
    {posts.map((post) => (
      <BlogPost
        url={post.url}
        title={post.frontmatter.title}
        tags={post.frontmatter.tags}
        pubDate={post.frontmatter.pubDate}
      />
    ))}
  </ul>
</BaseLayout>