---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogPost from '../../components/BlogPost.astro';
import { type PostEntry, getAllPosts, getAllTags, getPostTags } from '../../utils/posts';

interface Props {
  posts: PostEntry[];
}

export function getStaticPaths() {
  const allPosts = getAllPosts();

  return getAllTags(allPosts).map((tag) => ({
    params: { tag },
    props: { posts: allPosts.filter((post) => getPostTags(post).includes(tag)) },
  }));
}

const { tag = '' } = Astro.params;
const { posts } = Astro.props;
---

<BaseLayout pageTitle={tag} pageTitleZh={tag} pageTitleEn={tag}>
  <p><span class="lang-zh">包含「<strong>{tag}</strong>」标签的文章</span><span class="lang-en">Posts with tag «<strong>{tag}</strong>»</span></p>
  <ul class="tag-posts">
    {posts.map((post) => (
      <BlogPost
        url={post.url}
        title={post.frontmatter.title}
        tags={getPostTags(post)}
        pubDate={post.frontmatter.pubDate}
      />
    ))}
  </ul>
</BaseLayout>

<style>
  .tag-posts {
    list-style: none;
    padding: 0;
  }
</style>
