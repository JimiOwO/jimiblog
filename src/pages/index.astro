---
import BaseLayout from '../layouts/BaseLayout.astro';
import GlobeBackground from '../components/GlobeBackground.astro';
import { contact } from '../config/mefacts';
---

<BaseLayout pageTitle="首页" pageTitleZh="首页" pageTitleEn="Home">
  <section class="landing">
    <GlobeBackground />
    <h1 class="landing-title" id="landing-greeting">
      <span class="landing-word"></span>
      <span class="landing-cursor">|</span>
    </h1>
    <div class="landing-contact">
      <div class="landing-email-wrap">
        <button type="button" class="landing-email" data-email={contact.email} title="点击复制" data-title-zh="点击复制" data-title-en="Click to copy">
          {contact.email}
        </button>
        <span class="landing-copy-hint" aria-live="polite" data-hint-zh="已复制" data-hint-en="Copied"></span>
      </div>
      <a href={`tel:${contact.phoneTel}`} class="landing-contact-line">
        {contact.phone}
      </a>
      <a
        href={`https://earth.google.com/web/@${contact.locationLat},${contact.locationLng},500a,90d,0y,0h,0t,0r`}
        target="_blank"
        rel="noopener noreferrer"
        class="landing-contact-line"
        title="在 Google Earth 中查看"
        data-title-zh="在 Google Earth 中查看"
        data-title-en="View in Google Earth"
      >
        {contact.locationLabel} · {contact.locationLat.toFixed(2)}°, {contact.locationLng.toFixed(2)}°
      </a>
    </div>
  </section>

  <script>
    // 打字机效果：四种语言的问候语随机轮播
    (function () {
      const words = ['你好！我是Jimi。', "Hello! I'm Jimi.", '初めまして！Jimiです。', 'Hej! Jag är Jimi.'];
      const wordEl = document.querySelector<HTMLElement>('.landing-word');
      if (!wordEl) return;

      // 系统开启“减少动态效果”时不做打字动画，直接显示当前语言的问候语
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        wordEl.textContent = document.documentElement.lang === 'en' ? words[1] : words[0];
        return;
      }

      const typeDelay = 100;
      const deleteDelay = 20;
      const pauseAfterType = 1500;
      const pauseAfterDelete = 100;

      // 洗牌后依次取用，保证一轮内每句问候语各出现一次
      let deck: number[] = [];
      function refillDeck() {
        deck = words.map((_, i) => i);
        for (let i = deck.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [deck[i], deck[j]] = [deck[j], deck[i]];
        }
      }
      function nextIndex(): number {
        if (deck.length === 0) refillDeck();
        return deck.pop() ?? 0;
      }
      let wordIndex = nextIndex();
      let isDeleting = false;

      function tick() {
        const word = words[wordIndex];
        const current = wordEl!.textContent ?? '';

        if (!isDeleting) {
          if (current.length < word.length) {
            wordEl!.textContent = word.slice(0, current.length + 1);
            setTimeout(tick, typeDelay);
          } else {
            isDeleting = true;
            setTimeout(tick, pauseAfterType);
          }
        } else {
          if (current.length > 0) {
            wordEl!.textContent = current.slice(0, -1);
            setTimeout(tick, deleteDelay);
          } else {
            isDeleting = false;
            wordIndex = nextIndex();
            setTimeout(tick, pauseAfterDelete);
          }
        }
      }

      setTimeout(tick, 400);
    })();

    // 点击邮箱复制到剪贴板；复制失败时退回到 mailto 链接
    (function () {
      const btn = document.querySelector<HTMLButtonElement>('.landing-email');
      const hint = document.querySelector('.landing-copy-hint');
      if (!btn || !hint) return;
      const email = btn.dataset.email || '';
      let hideTimer: ReturnType<typeof setTimeout> | null = null;
      btn.addEventListener('click', async function (e) {
        e.preventDefault();
        try {
          await navigator.clipboard.writeText(email);
          const isEn = document.documentElement.lang === 'en';
          hint.textContent = isEn ? (hint.getAttribute('data-hint-en') || 'Copied') : (hint.getAttribute('data-hint-zh') || '已复制');
          hint.classList.add('is-visible');
          if (hideTimer) clearTimeout(hideTimer);
          hideTimer = setTimeout(function () {
            hint.classList.remove('is-visible');
            hideTimer = null;
          }, 1500);
        } catch (_) {
          window.location.href = 'mailto:' + email;
        }
      });
    })();
  </script>
</BaseLayout>

<style>
  .landing {
    position: relative;
    min-height: calc(100vh - 12rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-lg) var(--spacing-lg) var(--spacing-3xl);
    box-sizing: border-box;
    overflow: hidden;
  }

  .landing-title,
  .landing-contact {
    position: relative;
    z-index: 1;
  }

  .landing-title {
    margin: 0;
    font-size: clamp(2.5rem, 10vw, var(--font-size-4xl));
    font-weight: var(--font-weight-black);
    font-family: var(--font-family-base);
    color: var(--color-text);
    text-transform: none;
    letter-spacing: var(--letter-spacing-normal);
    border: none;
    padding: 0;
    line-height: 1.2;
    min-height: 1.2em;
  }

  .landing-word {
    display: inline-block;
  }

  .landing-cursor {
    color: var(--color-primary);
    animation: cursor-blink 1s step-end infinite;
  }

  @keyframes cursor-blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }

  .landing-contact {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-sm);
    margin-top: var(--spacing-xl);
    padding: 0 var(--spacing-lg);
    font-family: var(--font-family-base);
    width: 100%;
    box-sizing: border-box;
  }

  .landing-contact-line {
    display: inline-block;
    font-size: clamp(0.875rem, 2.5vw, 1.125rem);
    font-weight: 450;
    letter-spacing: var(--letter-spacing-normal);
    color: var(--color-text);
    text-decoration: none;
    border-bottom: var(--border-width-medium) solid transparent;
    transition: color var(--transition-base), border-color var(--transition-base);
  }

  .landing-contact-line:hover {
    color: var(--color-primary);
    border-bottom-color: var(--color-primary);
  }

  .landing-email-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-sm);
  }

  .landing-email {
    background: none;
    border: none;
    padding: 0;
    font-family: var(--font-family-base);
    font-size: clamp(0.875rem, 2.5vw, 1.125rem);
    font-weight: 450;
    letter-spacing: var(--letter-spacing-normal);
    color: var(--color-text);
    cursor: pointer;
    border-bottom: var(--border-width-medium) solid transparent;
    transition: color var(--transition-base), border-color var(--transition-base);
  }

  .landing-email:hover {
    color: var(--color-primary);
    border-bottom-color: var(--color-primary);
  }

  .landing-email:focus {
    outline: none;
  }

  .landing-email:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .landing-copy-hint {
    font-family: var(--font-family-base);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    color: var(--color-primary);
    opacity: 0;
    transition: opacity var(--transition-base);
  }

  .landing-copy-hint.is-visible {
    opacity: 1;
  }
</style>
