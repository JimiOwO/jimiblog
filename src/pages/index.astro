---
import BaseLayout from '../layouts/BaseLayout.astro';
const pageTitle = "首页";

const contact = {
  locationLabel: "Troy, NY",
  locationLat: 42.72364,
  locationLng: -73.695461,
  email: "jimipengowo@gmail.com",
  phone: "+1 518 246 0692",
  phoneTel: "+15182460692",
};
---

<BaseLayout pageTitle={pageTitle} pageTitleZh="首页" pageTitleEn="Home">
  <section class="landing">
    <h1 class="landing-title" id="landing-greeting">
      <span class="landing-word"></span>
      <span class="landing-cursor">|</span>
    </h1>
    <div class="landing-contact">
      <div class="landing-email-wrap">
        <button type="button" class="landing-email" data-email={contact.email} title="点击复制 / Click to copy">
          {contact.email}
        </button>
        <span class="landing-copy-hint" aria-live="polite" data-hint-zh="已复制" data-hint-en="Copied"></span>
      </div>
      <a href={`tel:${contact.phoneTel}`} class="landing-contact-line">
        {contact.phone}
      </a>
      <a href={`https://earth.google.com/web/@${contact.locationLat},${contact.locationLng},500a,90d,0y,0h,0t,0r`} target="_blank" rel="noopener noreferrer" class="landing-contact-line" title="在 Google Earth 中查看 / View in Google Earth">
        {contact.locationLabel} · {contact.locationLat.toFixed(4)}°, {contact.locationLng.toFixed(4)}°
      </a>
    </div>
  </section>

  <script>
    (function () {
      const words = ['你好！我是Jimi。', 'Hello! I\'m Jimi.', '初めまして！Jimiです。', 'Hej! Jag är Jimi.'];
      const wordEl = document.querySelector('.landing-word');
      const cursorEl = document.querySelector('.landing-cursor');
      if (!wordEl || !cursorEl) return;

      const typeDelay = 100;
      const deleteDelay = 20;
      const pauseAfterType = 1500;
      const pauseAfterDelete = 100;

      let wordIndex = Math.floor(Math.random() * words.length);
      let isDeleting = false;

      function nextRandomIndex() {
        if (words.length <= 1) return 0;
        var i = Math.floor(Math.random() * words.length);
        return i === wordIndex ? (wordIndex + 1) % words.length : i;
      }

      function tick() {
        const word = words[wordIndex];
        const current = wordEl.textContent;

        if (!isDeleting) {
          if (current.length < word.length) {
            wordEl.textContent = word.slice(0, current.length + 1);
            setTimeout(tick, typeDelay);
          } else {
            isDeleting = true;
            setTimeout(tick, pauseAfterType);
          }
        } else {
          if (current.length > 0) {
            wordEl.textContent = current.slice(0, -1);
            setTimeout(tick, deleteDelay);
          } else {
            isDeleting = false;
            wordIndex = nextRandomIndex();
            setTimeout(tick, pauseAfterDelete);
          }
        }
      }

      setTimeout(tick, 400);
    })();

    (function () {
      const btn = document.querySelector<HTMLButtonElement>('.landing-email');
      const hint = document.querySelector('.landing-copy-hint');
      if (!btn || !hint) return;
      const email = btn.dataset.email || '';
      let hideTimer: ReturnType<typeof setTimeout> | null = null;
      btn.addEventListener('click', async function (e) {
        e.preventDefault();
        try {
          await navigator.clipboard.writeText(email);
          const isZh = document.documentElement.lang === 'zh' || document.documentElement.lang === 'zh-CN';
          hint.textContent = isZh ? (hint.getAttribute('data-hint-zh') || '已复制') : (hint.getAttribute('data-hint-en') || 'Copied');
          hint.classList.add('is-visible');
          if (hideTimer) clearTimeout(hideTimer);
          hideTimer = setTimeout(function () {
            hint.classList.remove('is-visible');
            hideTimer = null;
          }, 1500);
        } catch (_) {
          window.location.href = 'mailto:' + email;
        }
      });
    })();
  </script>
</BaseLayout>

<style>
  .landing {
    min-height: calc(100vh - 12rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-lg) var(--spacing-lg) var(--spacing-3xl);
    box-sizing: border-box;
  }

  .landing-title {
    margin: 0;
    font-size: clamp(2.5rem, 10vw, var(--font-size-4xl));
    font-weight: var(--font-weight-black);
    font-family: var(--font-family-base);
    color: var(--color-text);
    text-transform: none;
    letter-spacing: var(--letter-spacing-normal);
    border: none;
    padding: 0;
    line-height: 1.2;
    min-height: 1.2em;
  }

  .landing-word {
    display: inline-block;
  }

  .landing-cursor {
    color: var(--color-primary);
    animation: cursor-blink 1s step-end infinite;
  }

  @keyframes cursor-blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }

  .landing-contact {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-sm);
    margin-top: var(--spacing-xl);
    padding: 0 var(--spacing-lg);
    font-family: var(--font-family-base);
    width: 100%;
    box-sizing: border-box;
  }

  .landing-contact-line {
    display: inline-block;
    font-size: clamp(0.875rem, 2.5vw, 1.125rem);
    font-weight: 450;
    letter-spacing: var(--letter-spacing-normal);
    color: var(--color-text);
    text-decoration: none;
    border-bottom: var(--border-width-medium) solid transparent;
    transition: color var(--transition-base), border-color var(--transition-base);
  }

  .landing-contact-line:hover {
    color: var(--color-primary);
    border-bottom-color: var(--color-primary);
  }

  .landing-email-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-sm);
  }

  .landing-email {
    background: none;
    border: none;
    padding: 0;
    font-family: var(--font-family-base);
    font-size: clamp(0.875rem, 2.5vw, 1.125rem);
    font-weight: 450;
    letter-spacing: var(--letter-spacing-normal);
    color: var(--color-text);
    cursor: pointer;
    border-bottom: var(--border-width-medium) solid transparent;
    transition: color var(--transition-base), border-color var(--transition-base);
  }

  .landing-email:hover {
    color: var(--color-primary);
    border-bottom-color: var(--color-primary);
  }

  .landing-email:focus {
    outline: none;
  }

  .landing-email:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .landing-copy-hint {
    font-family: var(--font-family-base);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    color: var(--color-primary);
    opacity: 0;
    transition: opacity var(--transition-base);
  }

  .landing-copy-hint.is-visible {
    opacity: 1;
  }

</style>
