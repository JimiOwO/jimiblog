---
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { PortfolioEntry } from '../../utils/portfolio';

// 作品展示顺序：按此数组从左到右、从上到下排列，未列出的会排在最后
const portfolioOrder = ['personal-blog','death-stranding-cursor','video-clips'];

const rawProjects = Object.values(
  import.meta.glob<PortfolioEntry>('./*.md', { eager: true })
);

function getSlug(entry: PortfolioEntry): string {
  return entry.url.replace(/\/$/, '').split('/').pop() ?? '';
}

const projects = [...rawProjects].sort((a, b) => {
  const i = portfolioOrder.indexOf(getSlug(a));
  const j = portfolioOrder.indexOf(getSlug(b));
  if (i === -1 && j === -1) return 0;
  if (i === -1) return 1;
  if (j === -1) return -1;
  return i - j;
});
---
<BaseLayout pageTitle="作品" pageTitleZh="作品" pageTitleEn="Portfolio">
  <div class="portfolio">
    <header class="portfolio-hero">
      <h1 class="portfolio-hero-bio bilingual-title">
        <span class="lang-zh">我做过的一些东西(和搞砸的)</span>
        <span class="lang-en">Things I've built(and broken)</span>
      </h1>
    </header>

    <div class="portfolio-grid">
      {projects.map((project) => (
        <article class="portfolio-card">
          <a href={project.url} class="portfolio-card-link" aria-label={project.frontmatter.titleZh + ' / ' + project.frontmatter.titleEn}></a>
          <div class="portfolio-card-preview">
            {project.frontmatter.preview ? (
              <img src={project.frontmatter.preview} alt="" loading="lazy" />
            ) : (
              <div class="portfolio-card-preview-placeholder" aria-hidden="true">
                <span>{project.frontmatter.titleZh.slice(0, 1)}</span>
              </div>
            )}
          </div>
          <div class="portfolio-card-body">
            <h2 class="portfolio-card-title">
              <span class="lang-zh">{project.frontmatter.titleZh}</span>
              <span class="lang-en">{project.frontmatter.titleEn}</span>
            </h2>
            <p class="portfolio-card-desc">
              <span class="lang-zh">{project.frontmatter.descZh}</span>
              <span class="lang-en">{project.frontmatter.descEn}</span>
            </p>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .portfolio {
    max-width: 1080px;
    margin: 0 auto;
    padding: var(--spacing-3xl) var(--container-padding);
  }

  .portfolio-hero {
    margin-bottom: calc(var(--spacing-2xl) + var(--spacing-sm));
    max-width: 720px;
  }

  .portfolio-hero-bio {
    margin: 0;
    font-size: clamp(1.9rem, 4.5vw, var(--font-size-page-title));
    font-weight: var(--font-weight-black);
    line-height: var(--line-height-tight);
    letter-spacing: var(--letter-spacing-tight);
    color: var(--color-text);
  }

  .portfolio-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--spacing-xl);
    align-items: stretch;
  }

  .portfolio-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background-color: var(--color-gray-200);
    border: var(--border-width-thin) solid var(--color-border-light);
    border-radius: var(--border-radius-md);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    min-height: 100%;
    transition:
      transform var(--transition-base),
      box-shadow var(--transition-base),
      border-color var(--transition-base),
      background-color var(--transition-base),
      color var(--transition-base);
    cursor: pointer;
  }

  html.dark .portfolio-card {
    background-color: var(--color-gray-800);
    border-color: var(--color-gray-700);
  }

  .portfolio-card-link {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .portfolio-card-preview {
    aspect-ratio: 16 / 9;
    width: 100%;
    background-color: var(--color-gray-300);
    overflow: hidden;
    pointer-events: none;
  }

  html.dark .portfolio-card-preview {
    background-color: var(--color-gray-700);
  }

  .portfolio-card-preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--transition-base);
  }

  @media (hover: hover) {
    .portfolio-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-lg);
      border-color: var(--color-primary);
      background-color: var(--color-primary);
      color: var(--color-white);
    }

    .portfolio-card:hover .portfolio-card-preview img {
      transform: scale(1.03);
    }

    .portfolio-card:hover .portfolio-card-title,
    .portfolio-card:hover .portfolio-card-desc {
      color: var(--color-white);
    }

    .portfolio-card:hover .portfolio-card-preview-placeholder span {
      color: var(--color-white);
    }
  }

  .portfolio-card-preview-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--color-gray-300) 0%, var(--color-gray-400) 100%);
  }

  html.dark .portfolio-card-preview-placeholder {
    background: linear-gradient(135deg, var(--color-gray-700) 0%, var(--color-gray-600) 100%);
  }

  .portfolio-card-preview-placeholder span {
    font-size: 3rem;
    font-weight: var(--font-weight-black);
    color: var(--color-text-secondary);
    opacity: 0.6;
  }

  .portfolio-card-body {
    flex: 1;
    padding: var(--spacing-lg);
    position: relative;
    z-index: 1;
    pointer-events: none;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .portfolio-card-title {
    margin: 0;
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    color: var(--color-text);
    transition: color var(--transition-base);
    line-height: 1.3;
  }

  .portfolio-card-desc {
    margin: 0;
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-secondary);
    transition: color var(--transition-base);
  }

  @media screen and (max-width: 900px) {
    .portfolio {
      padding-top: var(--spacing-2xl);
      padding-bottom: var(--spacing-2xl);
    }

    .portfolio-grid {
      gap: var(--spacing-lg);
    }
  }

  @media screen and (max-width: 600px) {
    .portfolio {
      padding-left: var(--spacing-md);
      padding-right: var(--spacing-md);
    }

    .portfolio-hero {
      margin-bottom: var(--spacing-2xl);
    }

    .portfolio-grid {
      grid-template-columns: 1fr;
      gap: var(--spacing-md);
    }

    .portfolio-card-body {
      padding: var(--spacing-md);
    }
  }
</style>
