---
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { PortfolioEntry } from '../../utils/portfolio';

const projects = Object.values(
  import.meta.glob<PortfolioEntry>('./*.md', { eager: true })
);
---
<BaseLayout pageTitle="作品" pageTitleZh="作品" pageTitleEn="Portfolio">
  <div class="portfolio">
    <header class="portfolio-hero">
      <h1 class="portfolio-hero-bio">
        <span class="lang-zh">我做过的一些东西(和搞砸的)</span>
        <span class="lang-en">Things I've built(and broken)</span>
      </h1>
    </header>

    <div class="portfolio-grid">
      {projects.map((project) => (
        <article class="portfolio-card">
          <a href={project.url} class="portfolio-card-link" aria-label={project.frontmatter.titleZh + ' / ' + project.frontmatter.titleEn}></a>
          <div class="portfolio-card-body">
            <h2 class="portfolio-card-title">
              <span class="lang-zh">{project.frontmatter.titleZh}</span>
              <span class="lang-en">{project.frontmatter.titleEn}</span>
            </h2>
            <p class="portfolio-card-desc">
              <span class="lang-zh">{project.frontmatter.descZh}</span>
              <span class="lang-en">{project.frontmatter.descEn}</span>
            </p>
            <ul class="portfolio-tags" aria-label="技术栈">
              {project.frontmatter.tags.map((tag: string) => (
                <li class="portfolio-tag">{tag}</li>
              ))}
            </ul>
          </div>
          <footer class="portfolio-card-footer">
            {project.frontmatter.github && (
              <a href={project.frontmatter.github} target="_blank" rel="noopener noreferrer" class="portfolio-link" aria-label="GitHub">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/>
                </svg>
                <span>GitHub</span>
              </a>
            )}
            {project.frontmatter.demo && (
              <a href={project.frontmatter.demo} target={project.frontmatter.demo.startsWith('http') ? '_blank' : '_self'} rel="noopener noreferrer" class="portfolio-link">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                  <polyline points="15 3 21 3 21 9"/>
                  <line x1="10" y1="14" x2="21" y2="3"/>
                </svg>
                <span class="lang-zh">预览</span>
                <span class="lang-en">Live</span>
              </a>
            )}
          </footer>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .portfolio {
    max-width: 896px;
    margin: 0 auto;
    padding: var(--spacing-3xl) var(--container-padding);
  }

  .portfolio-hero {
    margin-bottom: var(--spacing-3xl);
  }

  .portfolio-hero-bio {
    margin: 0;
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-black);
    line-height: var(--line-height-tight);
    letter-spacing: var(--letter-spacing-tight);
    color: var(--color-text);
  }

  .portfolio-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 13px;
  }

  .portfolio-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background-color: var(--color-gray-200);
    padding: var(--spacing-lg);
    transition: background-color var(--transition-base), color var(--transition-base);
    cursor: pointer;
  }

  html.dark .portfolio-card {
    background-color: var(--color-gray-800);
  }

  .portfolio-card-link {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  @media (hover: hover) {
    .portfolio-card:hover {
      background-color: var(--color-primary);
      color: var(--color-white);
    }

    .portfolio-card:hover .portfolio-card-title,
    .portfolio-card:hover .portfolio-card-desc,
    .portfolio-card:hover .portfolio-tag {
      color: var(--color-white);
    }

    .portfolio-card:hover .portfolio-link {
      color: rgba(255, 255, 255, 0.75);
    }

    .portfolio-card:hover .portfolio-link:hover {
      color: var(--color-white);
    }
  }

  .portfolio-card-body {
    flex: 1;
    position: relative;
    z-index: 1;
    pointer-events: none;
  }

  .portfolio-card-title {
    margin: 0 0 var(--spacing-sm);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    color: var(--color-text);
    transition: color var(--transition-base);
  }

  .portfolio-card-desc {
    margin: 0 0 var(--spacing-md);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-secondary);
    transition: color var(--transition-base);
  }

  .portfolio-tags {
    list-style: none;
    margin: 0 0 var(--spacing-lg);
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xs);
  }

  .portfolio-tag {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-secondary);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
    transition: color var(--transition-base);
  }

  .portfolio-card-footer {
    position: relative;
    z-index: 1;
    display: flex;
    gap: var(--spacing-md);
    flex-wrap: wrap;
  }

  .portfolio-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color var(--transition-base);
  }

  .portfolio-link:hover {
    color: var(--color-primary);
  }

  @media screen and (max-width: 600px) {
    .portfolio-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
