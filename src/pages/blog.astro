---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogPost from '../components/BlogPost.astro';
import { getAllPosts, getAllTags, getPostTags } from '../utils/posts';

const allPosts = getAllPosts();
const allTags = getAllTags(allPosts);
---

<BaseLayout pageTitle="博客" pageTitleZh="博客" pageTitleEn="Blog">
  <div class="blog-container">
    <header class="blog-hero">
      <h1 class="blog-hero-bio bilingual-title">
        <span class="lang-zh">记录想法，语言不限。</span>
        <span class="lang-en">Some thoughts,<br>in their original languages.</span>
      </h1>
    </header>
    <!-- 标签筛选器 -->
    <div class="blog-filters">
      <div class="filter-section">
        <div class="tags-container" id="tags-container">
          <button type="button" class="tag tag-filter active" data-filter="all" aria-pressed="true">
            <span class="lang-zh">全部</span>
            <span class="lang-en">All</span>
          </button>
          {allTags.map((tag) => (
            <button type="button" class="tag tag-filter" data-filter={tag} aria-pressed="false">{tag}</button>
          ))}
        </div>
      </div>
    </div>

    <!-- 博客文章列表 -->
    <ul class="blog-posts" id="blog-posts">
      {allPosts.map((post) => (
        <BlogPost
          url={post.url}
          title={post.frontmatter.title}
          tags={getPostTags(post)}
          pubDate={post.frontmatter.pubDate}
        />
      ))}
    </ul>

    <!-- 无结果提示 -->
    <div class="no-results" id="no-results" hidden>
      <p><span class="lang-zh">没有找到匹配标签的文章。</span><span class="lang-en">No posts match this tag.</span></p>
    </div>
  </div>
</BaseLayout>

<script>
  const ALL = 'all';
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('.tag-filter');
  const posts = document.querySelectorAll<HTMLElement>('#blog-posts > .blog-post-item');
  const noResults = document.getElementById('no-results');

  function filterPosts(selectedTag: string) {
    let visibleCount = 0;

    posts.forEach((post) => {
      const tags = (post.dataset.tags ?? '').split(',');
      const visible = selectedTag === ALL || tags.includes(selectedTag);
      post.hidden = !visible;
      if (visible) visibleCount++;
    });

    if (noResults) noResults.hidden = visibleCount > 0;

    filterButtons.forEach((btn) => {
      const active = btn.dataset.filter === selectedTag;
      btn.classList.toggle('active', active);
      btn.setAttribute('aria-pressed', String(active));
    });
  }

  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const tag = btn.dataset.filter ?? ALL;
      filterPosts(tag);
      // 把当前筛选写回地址栏，方便刷新或分享链接后保持同一筛选
      const url = new URL(window.location.href);
      if (tag === ALL) url.searchParams.delete('tag');
      else url.searchParams.set('tag', tag);
      history.replaceState(null, '', url);
    });
  });

  // 页面加载时读取 URL 的 ?tag= 参数并自动激活对应标签
  const urlTag = new URLSearchParams(window.location.search).get('tag');
  if (urlTag) filterPosts(urlTag);
</script>

<style>
  .blog-container {
    max-width: 900px;
    margin: 0 auto;
  }

  .blog-hero {
    margin-bottom: var(--spacing-3xl);
  }

  .blog-hero-bio {
    margin: 0;
    font-size: clamp(1.9rem, 4.5vw, var(--font-size-page-title));
    font-weight: var(--font-weight-black);
    line-height: var(--line-height-tight);
    letter-spacing: var(--letter-spacing-tight);
    color: var(--color-text);
  }

  .blog-filters {
    margin-bottom: var(--spacing-xl);
    padding-bottom: var(--spacing-lg);
    border-bottom: var(--border-width-thin) solid var(--color-border-light);
  }

  .tags-container {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
  }

  .tag-filter {
    cursor: pointer;
    border: var(--border-width-thin) solid var(--color-border);
    background-color: var(--color-bg);
    color: var(--color-text);
    transition: all var(--transition-base);
    font-family: var(--font-family-base);
    font-size: var(--font-size-sm);
    padding: var(--spacing-xs) var(--spacing-md);
    border-radius: var(--border-radius-md);
  }

  .tag-filter:hover {
    border-color: var(--color-primary);
    background-color: var(--color-bg-secondary);
    transform: translateY(-1px);
  }

  .tag-filter.active {
    background-color: var(--color-primary);
    color: var(--color-white);
    border-color: var(--color-primary);
  }

  .blog-posts {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .no-results {
    text-align: center;
    padding: var(--spacing-2xl);
    color: var(--color-text-secondary);
  }

  @media screen and (max-width: 768px) {
    .tags-container {
      gap: var(--spacing-xs);
    }

    .tag-filter {
      font-size: var(--font-size-xs);
      padding: var(--spacing-xs) var(--spacing-sm);
    }
  }
</style>
