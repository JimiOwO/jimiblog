---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogPost from '../components/BlogPost.astro';
import { type PostEntry, sortPostsByDate } from '../utils/posts';

const allPosts = sortPostsByDate(
  Object.values(import.meta.glob<PostEntry>('./posts/*.md', { eager: true })) as PostEntry[]
);
const allTags = [...new Set(allPosts.map((post) => post.frontmatter.tags).flat())].sort();
const pageTitle = "博客";
---

<BaseLayout pageTitle={pageTitle} pageTitleZh="博客" pageTitleEn="Blog">
  <div class="blog-container">
    <header class="blog-hero">
      <h1 class="blog-hero-bio">
        <span class="lang-zh">记录想法，语言不限。</span>
        <span class="lang-en">Some thoughts. Please use tranlation software if you don't understand :D</span>
      </h1>
    </header>
    <!-- 标签筛选器 -->
    <div class="blog-filters">
      <div class="filter-section">
        <div class="tags-container" id="tags-container">
          <button class="tag tag-filter active" data-filter="all">
            <span class="lang-zh">全部</span>
            <span class="lang-en">All</span>
          </button>
          {allTags.map((tag) => (
            <button class="tag tag-filter" data-filter={tag}>{tag}</button>
          ))}
        </div>
      </div>
    </div>

    <!-- 博客文章列表 -->
    <div class="blog-posts" id="blog-posts">
      {allPosts.map((post) => (
        <div 
          class="blog-post-wrapper" 
          data-tags={post.frontmatter.tags.join(',')}
        >
          <BlogPost 
            url={post.url} 
            title={post.frontmatter.title}
            tags={post.frontmatter.tags}
            pubDate={post.frontmatter.pubDate}
          />
        </div>
      ))}
    </div>

    <!-- 无结果提示 -->
    <div class="no-results" id="no-results" style="display: none;">
      <p><span class="lang-zh">没有找到匹配标签的文章。</span><span class="lang-en">No posts match this tag.</span></p>
    </div>
  </div>
</BaseLayout>

<script>
  const filterButtons = document.querySelectorAll<HTMLElement>('.tag-filter');
  const postWrappers = document.querySelectorAll<HTMLElement>('.blog-post-wrapper');
  const noResults = document.getElementById('no-results');

  function filterPosts(selectedTag: string) {
    let visibleCount = 0;

    postWrappers.forEach((el) => {
      const tags = el.getAttribute('data-tags')?.split(',') ?? [];
      const visible = selectedTag === 'all' || tags.includes(selectedTag);
      el.style.display = visible ? 'block' : 'none';
      if (visible) visibleCount++;
    });

    if (noResults) {
      noResults.style.display = visibleCount === 0 ? 'block' : 'none';
    }

    filterButtons.forEach((btn) => {
      btn.classList.toggle('active', btn.getAttribute('data-filter') === selectedTag);
    });
  }

  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterPosts(btn.getAttribute('data-filter') ?? 'all');
    });
  });

  // 页面加载时读取 URL 的 ?tag= 参数并自动激活对应标签
  const urlTag = new URLSearchParams(window.location.search).get('tag');
  if (urlTag) {
    filterPosts(urlTag);
  }
</script>

<style>
  .blog-container {
    max-width: 900px;
    margin: 0 auto;
  }

  .blog-hero {
    margin-bottom: var(--spacing-3xl);
  }

  .blog-hero-bio {
    margin: 0;
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-black);
    line-height: var(--line-height-tight);
    letter-spacing: var(--letter-spacing-tight);
    color: var(--color-text);
  }

  .blog-filters {
    margin-bottom: var(--spacing-xl);
    padding-bottom: var(--spacing-lg);
    border-bottom: var(--border-width-thin) solid var(--color-border-light);
  }

  .tags-container {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
  }

  .tag-filter {
    cursor: pointer;
    border: var(--border-width-thin) solid var(--color-border);
    background-color: var(--color-bg);
    color: var(--color-text);
    transition: all var(--transition-base);
    font-family: var(--font-family-base);
    font-size: var(--font-size-sm);
    padding: var(--spacing-xs) var(--spacing-md);
    border-radius: var(--border-radius-md);
  }

  .tag-filter:hover {
    border-color: var(--color-primary);
    background-color: var(--color-bg-secondary);
    transform: translateY(-1px);
  }

  .tag-filter.active {
    background-color: var(--color-primary);
    color: var(--color-white);
    border-color: var(--color-primary);
  }

  .blog-posts {
    list-style: none;
    padding: 0;
  }

  .blog-post-wrapper {
    margin-bottom: var(--spacing-md);
    transition: opacity var(--transition-base);
  }

  .no-results {
    text-align: center;
    padding: var(--spacing-2xl);
    color: var(--color-text-secondary);
  }

  @media screen and (max-width: 768px) {
    .tags-container {
      gap: var(--spacing-xs);
    }

    .tag-filter {
      font-size: var(--font-size-xs);
      padding: var(--spacing-xs) var(--spacing-sm);
    }
  }
</style>
