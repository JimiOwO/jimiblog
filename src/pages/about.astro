---
import BaseLayout from '../layouts/BaseLayout.astro';

const photoDir = '/2023 冬季特洛伊随记';
const photoNames = ['561z000_561z000-R1-E001.jpg', '561z000_561z000-R1-E005.jpg', '561z000_561z000-R1-E010.jpg', '561z000_561z000-R1-E015.jpg', '561z000_561z000-R1-E020.jpg', '561z000_561z000-R1-E025.jpg', '561z000_561z000-R1-E030.jpg', '561z000_561z000-R1-E035.jpg', '561z000_561z000-R1-E038.jpg'];

function shuffle<T>(arr: T[]): T[] {
  const a = [...arr];
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}
const shuffledPhotos = shuffle(photoNames);

const rawItems = [
  { tag: '编程', tagEn: 'Coding', size: 'l', detail: '[在此填写编程方面的细节]', detailEn: '[Your coding details here]' },
  { tag: '设计', tagEn: 'Design', size: 'm', detail: '[在此填写设计方面的细节]', detailEn: '[Your design details here]' },
  { tag: '音乐', tagEn: 'Music', size: 's', detail: '[在此填写音乐方面的细节]', detailEn: '[Your music details here]' },
  { tag: '阅读', tagEn: 'Reading', size: 'm', detail: '[在此填写阅读方面的细节]', detailEn: '[Your reading details here]' },
  { tag: '语言学习', tagEn: 'Languages', size: 's', detail: '[在此填写语言学习方面的细节]', detailEn: '[Your language learning details here]' },
  { tag: '游戏', tagEn: 'Gaming', size: 'x', detail: '[在此填写游戏方面的细节]', detailEn: '[Your gaming details here]' },
  { tag: '写作', tagEn: 'Writing', size: 's', detail: '[在此填写写作方面的细节]', detailEn: '[Your writing details here]' },
  { tag: '摄影', tagEn: 'Photography', size: 'm', detail: '[在此填写摄影方面的细节]', detailEn: '[Your photography details here]' },
  { tag: '运动', tagEn: 'Sports', size: 's', detail: '[在此填写运动方面的细节]', detailEn: '[Your sports details here]' },
].map((item, i) => ({ ...item, image: photoDir + '/' + shuffledPhotos[i] }));
---
<BaseLayout pageTitle="关于" pageTitleZh="关于" pageTitleEn="About">
  <main class="about">
    <header class="about-hero">
      <p class="about-hero-bio">
        <span class="lang-zh">用文字与项目记录生活与思考。</span>
        <span class="lang-en">Writing and projects that capture life and thoughts.</span>
      </p>
    </header>

    <div class="about-backdrop" id="about-backdrop" aria-hidden="true"></div>
    <div class="about-grid" aria-label="爱好与能力">
        {rawItems.map((item) => (
          <article class={`about-card about-card--${item.size}`} tabindex="0" style={`--card-bg: url("${item.image}")`}>
          <h2 class="about-card-title">
            <span class="lang-zh">{item.tag}</span>
            <span class="lang-en">{item.tagEn}</span>
          </h2>
          <p class="about-card-detail">
            <span class="lang-zh">{item.detail}</span>
            <span class="lang-en">{item.detailEn}</span>
          </p>
        </article>
      ))}
    </div>
  </main>

  <script is:inline>
    (function () {
      var cards = document.querySelectorAll('.about-card');
      var backdrop = document.getElementById('about-backdrop');
      var openCard = null;

      function collapse() {
        if (openCard) {
          openCard.classList.remove('about-card--open');
          backdrop.classList.remove('about-backdrop--visible');
          backdrop.setAttribute('aria-hidden', 'true');
          openCard = null;
        }
      }

      function expand(e) {
        var card = e.currentTarget;
        var r = card.getBoundingClientRect();
        card.style.setProperty('--start-left', r.left + 'px');
        card.style.setProperty('--start-top', r.top + 'px');
        card.style.setProperty('--start-width', r.width + 'px');
        card.style.setProperty('--start-height', r.height + 'px');
        if (openCard) openCard.classList.remove('about-card--open');
        openCard = card;
        card.classList.add('about-card--open');
        backdrop.classList.add('about-backdrop--visible');
        backdrop.setAttribute('aria-hidden', 'false');
      }

      if (backdrop) {
        backdrop.addEventListener('click', collapse);
        backdrop.addEventListener('mouseenter', collapse);
      }
      cards.forEach(function (card) {
        card.addEventListener('mouseenter', expand);
        card.addEventListener('focus', expand);
        card.addEventListener('blur', function (e) {
          if (!e.currentTarget.contains(e.relatedTarget)) collapse();
        });
      });
    })();
  </script>
</BaseLayout>

<style>
  .about {
    max-width: 560px;
    margin: 0 auto;
    padding: var(--spacing-3xl) var(--container-padding);
  }

  .about-hero {
    margin-bottom: var(--spacing-3xl);
  }

  .about-hero-bio {
    margin: 0;
    font-size: var(--font-size-base);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-secondary);
  }

  .about-backdrop {
    position: fixed;
    inset: 0;
    z-index: calc(var(--z-modal) - 1);
    background: rgba(0, 0, 0, 0.15);
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--transition-base);
  }

  .about-backdrop--visible {
    pointer-events: auto;
    opacity: 1;
  }

  /* Metro 风格网格：4 列等分，s=1×1, m=2×1, l=2×2, x=1×2 */
  .about-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 80px;
    gap: 8px;
  }

  .about-card {
    position: relative;
    background-color: var(--color-bg-secondary);
    background-image: var(--card-bg);
    background-size: cover;
    background-position: center;
    border-radius: 0;
    cursor: default;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-md);
    outline: none;
    transition: background var(--transition-base);
  }

  .about-card--s {
    grid-column: span 1;
    grid-row: span 1;
  }

  .about-card--m {
    grid-column: span 2;
    grid-row: span 1;
  }

  .about-card--l {
    grid-column: span 2;
    grid-row: span 2;
  }

  .about-card--x {
    grid-column: span 1;
    grid-row: span 2;
  }

  .about-card--open {
    position: fixed;
    z-index: var(--z-modal);
    border-radius: var(--border-radius-md);
    min-height: unset;
    animation: about-expand-from 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
  }

  @keyframes about-expand-from {
    from {
      left: var(--start-left, 50%);
      top: var(--start-top, 50%);
      width: var(--start-width, 65vw);
      height: var(--start-height, 65vh);
      transform: translate(0, 0);
    }
    to {
      left: 50%;
      top: 50%;
      width: 65vw;
      height: 65vh;
      transform: translate(-50%, -50%);
    }
  }

  .about-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.35);
    pointer-events: none;
  }

  .about-card-title,
  .about-card-detail {
    position: relative;
    z-index: 1;
  }

  .about-card-title {
    margin: 0;
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-white);
    text-align: center;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
  }

  .about-card:hover .about-card-title,
  .about-card:focus-within .about-card-title,
  .about-card--open .about-card-title {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
  }

  .about-card-detail {
    margin: var(--spacing-sm) 0 0;
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-normal);
    color: rgba(255, 255, 255, 0.9);
    line-height: var(--line-height-relaxed);
    text-align: center;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: max-height var(--transition-slow), opacity var(--transition-base), margin var(--transition-base);
  }

  .about-card:hover .about-card-detail,
  .about-card:focus-within .about-card-detail,
  .about-card--open .about-card-detail {
    max-height: 160px;
    opacity: 1;
    margin-top: var(--spacing-md);
    font-size: var(--font-size-base);
  }
</style>
