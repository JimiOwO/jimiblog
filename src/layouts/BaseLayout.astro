---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_NAME } from '../config/site';
import '../styles/global.css';

interface Props {
  pageTitle: string;
  pageTitleZh?: string;
  pageTitleEn?: string;
  /** 页面摘要，用于 <meta name="description"> 与分享卡片 */
  description?: string;
}

const { pageTitle, pageTitleZh = pageTitle, pageTitleEn = pageTitle, description } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const fullTitleZh = `${pageTitleZh} | ${SITE_NAME}`;
const fullTitleEn = `${pageTitleEn} | ${SITE_NAME}`;
---

<!doctype html>
<html lang="zh" data-page-title-zh={fullTitleZh} data-page-title-en={fullTitleEn}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/icons/Jimi_dark.png" />
    <title>{fullTitleZh}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitleZh} />
    {description && <meta property="og:description" content={description} />}
    <!-- 首屏渲染前就确定语言与主题，避免闪烁；之后的切换逻辑在 LangToggle 和 ThemeIcon 组件里 -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var lang = 'zh';
        var manualTheme = null;
        try {
          if (localStorage.getItem('lang') === 'en') lang = 'en';
          // 只有用户手动切换过主题才使用保存值，否则始终跟随系统
          if (localStorage.getItem('themeSource') === 'manual') manualTheme = localStorage.getItem('theme');
        } catch (e) {}

        root.lang = lang;
        root.classList.toggle('lang-en', lang === 'en');
        root.classList.toggle('lang-zh', lang === 'zh');
        var title = root.getAttribute('data-page-title-' + lang);
        if (title) document.title = title;

        var dark = manualTheme
          ? manualTheme === 'dark'
          : window.matchMedia('(prefers-color-scheme: dark)').matches;
        root.classList.toggle('dark', dark);
      })();
    </script>
  </head>
  <body>
    <div class="top-line"></div>

    <Header currentPath={currentPath} />

    <main class="main-content">
      <slot />
    </main>

    <Footer />
  </body>
</html>
