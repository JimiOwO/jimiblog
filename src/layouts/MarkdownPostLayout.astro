---
import BaseLayout from './BaseLayout.astro';
const { frontmatter } = Astro.props;
---

<BaseLayout pageTitle={frontmatter.title}>
  <header class="post-header">
    <h1 class="post-title">{frontmatter.title}</h1>
    <p class="post-description"><em>{frontmatter.description}</em></p>
    <p class="post-date">{frontmatter.pubDate.toString().slice(0, 10)}</p>
    <div class="post-tags">
      {frontmatter.tags.map((tag: string) => (
        <span class="tag">
          <a href={`/tags/${tag}`}>{tag}</a>
        </span>
      ))}
    </div>
  </header>

  {frontmatter.image && (
    <img 
      src={frontmatter.image.url} 
      alt={frontmatter.image.alt}
      class="post-image"
    />
  )}

  <article class="post-content">
    <slot />
  </article>
</BaseLayout>

<style>
  .post-header {
    margin-bottom: var(--spacing-xl);
    padding-bottom: var(--spacing-lg);
    border-bottom: var(--border-width-thin) solid var(--color-border-light);
  }

  .post-title {
    font-size: clamp(1.75rem, 5vw, var(--font-size-4xl));
    font-weight: var(--font-weight-black);
    color: var(--color-text);
    margin: 0 0 var(--spacing-md) 0;
    line-height: var(--line-height-tight);
    letter-spacing: var(--letter-spacing-tight);
    border: none;
    padding-left: 0;
    text-transform: none;
  }

  .post-description {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    font-style: italic;
    margin: 0 0 var(--spacing-sm) 0;
  }

  .post-date {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    margin: 0 0 var(--spacing-md) 0;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xs);
  }

  .post-tags .tag {
    font-size: var(--font-size-sm);
    padding: 2px var(--spacing-xs);
  }

  .post-tags .tag a {
    font-size: inherit;
  }

  .post-image {
    width: 100%;
    max-width: 600px;
    margin: var(--spacing-xl) auto;
    border: var(--border-width-thin) solid var(--color-border-light);
  }

  .post-content {
    margin-top: var(--spacing-xl);
  }

  .post-content :global(h2) {
    margin-top: var(--spacing-2xl);
  }

  .post-content :global(h3) {
    margin-top: var(--spacing-xl);
  }

  /* 正文内插入的图片：Markdown 写法 ![](/images/xxx.jpg) 或 ![说明](/images/xxx.jpg) */
  .post-content :global(img) {
    width: 100%;
    max-width: 100%;
    height: auto;
    display: block;
    margin: var(--spacing-xl) 0;
    border-radius: var(--border-radius-sm);
    border: var(--border-width-thin) solid var(--color-border-light);
    box-shadow: var(--shadow-sm);
  }

  .post-content :global(figure) {
    margin: var(--spacing-xl) 0;
  }

  .post-content :global(figure img) {
    margin: 0;
  }

  .post-content :global(figcaption) {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    text-align: center;
    margin-top: var(--spacing-sm);
  }
</style>